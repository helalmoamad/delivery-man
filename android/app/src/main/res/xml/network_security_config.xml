<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext HTTP is off everywhere by default. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Backend hosts are allowed to fall back to HTTP so that any legacy
         http:// URL still returned by the API keeps working. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">trydos.com</domain>
        <domain includeSubdomains="true">trydos.dev</domain>
        <domain includeSubdomains="true">ramaaz.dev</domain>
    </domain-config>
</network-security-config>
